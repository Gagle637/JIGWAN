# 이 파일을 복사해 .env로 만들고 값을 채운다. .env는 git에 올리지 않는다.
# cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL + PostGIS ---
POSTGRES_DB=jigwan
POSTGRES_USER=jigwan
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (broker=/0, result backend=/1, cache/lock=/2) ---
REDIS_URL=redis://redis:6379

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT (SimpleJWT) ---
JWT_SIGNING_KEY=change-me

# --- CDSE(Copernicus Data Space Ecosystem) S3 ---
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu

# --- 공공데이터포털(국토부 실거래가) ---
DATA_GO_KR_API_KEY=

# --- 생활안전지도(범죄주의구간 WMS) ---
SAFEMAP_API_KEY=
# probe_crime_feature_cap으로 확인한 GetFeatureInfo 숨은 상한. 비워 두면 run_safety_sync가
# 시작 전에 멈춘다.
CRIME_FEATURE_CAP=
# 포털에서 확인한 실제 데이터 기간(예: 2023-07/2024-06). 매년 갱신 필요.
CRIME_DATA_PERIOD=

# --- LLM(gpt-oss, OpenAI 호환) ---
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=openai/gpt-oss-20b

# --- TiTiler ---
TITILER_BASE_URL=http://titiler:8000

# --- 데모(13단계) ---
# true면 demo/fixtures/demo_snapshots.json에 있는 PNU는 GPU·외부 API 없이 고정값을
# 돌려준다(그 외 건물은 평소처럼 동작). 시연 전에 fixture의 예시 PNU를 실제 적재된
# 건물의 PNU로 바꿔야 한다.
DEMO_MODE=False
