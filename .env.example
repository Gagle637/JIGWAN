# 이 파일을 복사해 .env로 만들고 값을 채운다. .env는 git에 올리지 않는다.
# cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL + PostGIS ---
POSTGRES_DB=jigwan
POSTGRES_USER=jigwan
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (broker=/0, result backend=/1, cache/lock=/2) ---
REDIS_URL=redis://redis:6379

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT (SimpleJWT) ---
JWT_SIGNING_KEY=change-me

# --- 위성 장면 검색(STAC) ---
# eo:cloud_cover 상한(기본 70). 장마철 여름 계절처럼 타일 전체 구름양 때문에 장면이
# 너무 적게 걸리면 올린다(README 13단계 참고).
SATELLITE_MAX_CLOUD_PCT=70

# --- CDSE(Copernicus Data Space Ecosystem) S3 ---
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu

# --- 공공데이터포털(국토부 실거래가) ---
DATA_GO_KR_API_KEY=

# --- 생활안전지도(범죄주의구간 WMS) ---
SAFEMAP_API_KEY=
# probe_crime_feature_cap으로 확인한 GetFeatureInfo 숨은 상한. 비워 두면 run_safety_sync가
# 시작 전에 멈춘다.
CRIME_FEATURE_CAP=
# 포털에서 확인한 실제 데이터 기간(예: 2023-07/2024-06). 매년 갱신 필요.
CRIME_DATA_PERIOD=

# --- LLM(gpt-oss, OpenAI 호환) ---
# 기본은 로컬 Ollama(GPU 서버 없이 무료로 쓰기 위해). host.docker.internal은 컨테이너
# 안에서 호스트를 가리키는 특수 주소 — localhost로 쓰면 컨테이너 자기 자신을 가리켜 안 된다.
# 먼저 호스트에서: ollama pull gpt-oss:20b (README 참고. :cloud가 붙은 모델은 쓰지 말 것)
# 주의(실측 확인): Docker Desktop(특히 WSL2)에서 host.docker.internal이 docker compose exec로
# 띄운 새 프로세스에서는 잘 풀리는데, 컨테이너 시작 때부터 떠 있는 worker-gpu 프로세스
# 자체에서는 계속 "No address associated with hostname"으로 실패하는 타이밍 문제가 있었다.
# 이 증상이 나오면 호스트명 대신 아래로 바꾼다(IP는 docker compose exec worker-gpu
# getent hosts host.docker.internal 로 확인 — Docker Desktop을 재설치하면 바뀔 수 있다):
# LLM_BASE_URL=http://192.168.65.254:11434/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=gpt-oss:20b
# NVIDIA GPU가 있으면 vLLM으로 바꿀 수 있다(docker compose --profile llm up -d vllm):
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_MODEL=openai/gpt-oss-20b
# 로컬 실행은 느릴 수 있어 LLM 호출 제한 시간을 늘릴 수 있다(기본 480초 — 실측 근거는
# backend/config/settings.py 주석 참고).
LLM_TIMEOUT_SECONDS=480

# --- TiTiler ---
TITILER_BASE_URL=http://titiler:8000

# --- 데모(13단계) ---
# true면 demo/fixtures/demo_snapshots.json에 있는 PNU는 GPU·외부 API 없이 고정값을
# 돌려준다(그 외 건물은 평소처럼 동작). 시연 전에 fixture의 예시 PNU를 실제 적재된
# 건물의 PNU로 바꿔야 한다.
DEMO_MODE=False
